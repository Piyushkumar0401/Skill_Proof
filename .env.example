# GEMINI_API_KEY: Required for Gemini AI evaluations, learning roadmaps, and AI assistant.
# Configure this in your server environment or AI Studio Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Connection string for MongoDB (e.g. MongoDB Atlas or local mongod).
# When omitted in local development, SkillProof falls back to an embedded MongoDB instance.
MONGODB_URI="mongodb://127.0.0.1:27017/skillproof"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# CORS_ORIGIN: Allowed frontend origin in production (comma-separated if multiple).
CORS_ORIGIN="http://localhost:3000"

# PORT: Server port (defaults to 3000).
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
